generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  unread
  read
}

enum SceneType {
  earth
  grid
  cityscape
  mesh
}

enum SceneGlow {
  red
  blue
  green
  gold
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Job {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  department      String
  location        String
  jobType         String
  employmentType  String
  description     String
  responsibilities Json
  requirements    Json
  benefits        Json
  applyUrl        String?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  iconUrl     String?
  imageUrl    String?
  highlights  Json
  challenge   String
  solution    String
  results     String
  metrics     Json
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(false)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contract {
  id             String   @id @default(cuid())
  name           String
  contractNumber String
  agency         String
  period         String
  contractType   String
  availability   String
  programManager String
  email          String
  phone          String
  summary        String
  scope          String
  isPublished    Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LeadershipMember {
  id          String   @id @default(cuid())
  name        String
  title       String
  photoUrl    String?
  shortBio    String
  fullBio     String
  linkedInUrl String?
  displayOrder Int     @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  quote       String
  authorName  String
  authorTitle String
  organization String
  isPublished Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceItem {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String
  bulletItems Json
  displayOrder Int     @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MissionPartner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  displayOrder Int     @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PartnershipContact {
  id           String   @id @default(cuid())
  name         String
  organization String
  category     String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactSubmission {
  id        String           @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    SubmissionStatus @default(unread)
  createdAt DateTime         @default(now())
}

model SupportTicket {
  id            String   @id @default(cuid())
  clientName    String
  requesterName String
  requesterEmail String
  pageUrl       String
  requestType   String
  priority      String
  summary       String
  details       String
  attachments   Json
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GlobalSetting {
  id             String   @id @default(cuid())
  companyName    String
  tagline        String
  email          String
  phone          String
  address        String
  linkedInUrl    String?
  footerStatement String
  heroEyebrow    String
  heroHeadline   String
  heroTrustBadge String
  heroSubheadline String
  aboutHeroImageUrl String?
  caseStudiesHeroImageUrl String?
  caseStudyDetailFallbackImageUrl String?
  careersHeroImageUrl String?
  contactHeroImageUrl String?
  contractsHeroImageUrl String?
  privacyHeroImageUrl String?
  capabilityStatementUrl String @default("/capabilities/joint-capability-statement.pdf")
  homepageSceneType SceneType @default(grid)
  homepageSceneGlow SceneGlow @default(blue)
  homepageSceneParticles Boolean @default(true)
  homepageSceneParallax Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
